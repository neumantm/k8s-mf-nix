{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices"
  ],

  lockFileMaintenance: {
    "enabled": true
  },

  nix: {
    "enabled": true
  },

  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['*.nix'],
      matchStrings: [
        'Version\\s*=\\s*"(?<currentValue>\\S+)";\\s*# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s'
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
  ],
}
